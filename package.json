{
  "name": "hyper-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web \"npm run dev -w @hyper/api\" \"npm run worker -w @hyper/api\" \"npm run dev -w @hyper/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:runtime:dsh": "tsx --test tests/runtime/dsh.test.ts",
    "test:runtime:hermes": "tsx --test tests/runtime/hermes.test.ts",
    "test:runtime": "tsx --test --test-concurrency=1 tests/runtime/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build",
    "migrate": "npm run migrate -w @hyper/api",
    "seed": "npm run seed -w @hyper/api",
    "workspace:init": "npm run workspace:init -w @hyper/api",
    "test:nextcloud": "playwright test --config playwright.nextcloud.config.ts",
    "test:deployment": "playwright test --config playwright.deployment.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "concurrently": "9.2.5",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "@nestjs/platform-express": "11.2.8"
  },
  "overrides": {
    "multer": "2.5.0",
    "esbuild": "0.28.1"
  }
}
