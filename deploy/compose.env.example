# Generate private values with: node scripts/deploy-init.mjs
DB_PASSWORD=GENERATE_DATABASE_PASSWORD
CREDENTIAL_MASTER_KEY=GENERATE_CREDENTIAL_MASTER_KEY
APP_ORIGIN=http://127.0.0.1:8080
HYPER_PORT=8080
# Enterprise deployment requires an independently managed compatible Nextcloud.
NEXTCLOUD_URL=
NEXTCLOUD_INTERNAL_URL=
NEXTCLOUD_WORKSPACE_ID=GENERATE_WORKSPACE_UUID
NEXTCLOUD_MEMBER_GROUP=
NEXTCLOUD_BOOTSTRAP_ADMIN_IDS=[]
WORKSPACE_NAME=Hyper Workspace
NEXTCLOUD_TALK_ENABLED=false
NEXTCLOUD_FILES_ENABLED=false
DEMO_MODE=false
