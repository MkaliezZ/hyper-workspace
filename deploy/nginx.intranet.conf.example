# Install within Nginx's http context after replacing 192.168.10.50 with the
# reserved LAN IP. The certificate must contain that IP as an IP SAN.
# Backend ports match HYPER_HTTP_PORT=8180 / HYPER_NEXTCLOUD_PORT=8090.
server {
    listen 192.168.10.50:443 ssl;
    server_name 192.168.10.50;
    ssl_certificate /etc/hyper-workspace/tls/server-chain.pem;
    ssl_certificate_key /etc/hyper-workspace/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # URLs can contain one-shot source flow tokens; keep access logs disabled.
    access_log off;
    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:8180;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 75s;
        # A missing receipt must not cause a write to be replayed upstream.
        proxy_next_upstream off;
    }
}

server {
    listen 192.168.10.50:8443 ssl;
    server_name 192.168.10.50;
    ssl_certificate /etc/hyper-workspace/tls/server-chain.pem;
    ssl_certificate_key /etc/hyper-workspace/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 75s;
        proxy_next_upstream off;
    }
}
