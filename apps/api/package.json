{
  "name": "@hyper/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import ../../scripts/load-env.mjs --import tsx --watch src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "node --import ../../scripts/load-env.mjs --import tsx src/db/cli.ts migrate",
    "seed": "node --import ../../scripts/load-env.mjs --import tsx src/db/cli.ts seed",
    "start": "node --import ../../scripts/load-env.mjs --import tsx src/main.ts",
    "worker": "node --import ../../scripts/load-env.mjs --import tsx --watch src/worker.ts",
    "workspace:init": "node --import ../../scripts/load-env.mjs --import tsx src/db/cli.ts workspace:init"
  },
  "dependencies": {
    "@hyper/contracts": "0.1.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "express": "5.2.1",
    "fast-xml-parser": "5.11.2",
    "pg": "8.16.3",
    "pg-boss": "12.38.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.15.6"
  }
}
