# Copy to .env. No real secrets belong in Git.
DATABASE_URL=postgres://hyper:hyper-local@127.0.0.1:5432/hyper
API_PORT=3100
# Keep development loopback; containers set API_HOST=0.0.0.0 explicitly.
API_HOST=127.0.0.1
# Serve only the built apps/web/dist. Vite development remains separate.
SERVE_WEB=false
# Compose pre-creates the queue schema for its restricted role; normal development creates it.
QUEUE_SCHEMA_PRECREATED=false
APP_ORIGIN=http://127.0.0.1:5173
# Demo is explicitly opt-in. Never enable on a public server.
DEMO_MODE=false
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_MASTER_KEY=
DSH_COMMAND=
HERMES_COMMAND=
NEXTCLOUD_URL=
# Optional trusted internal transport URL. Public URL must match Login Flow responses.
NEXTCLOUD_INTERNAL_URL=
# A new enterprise workspace UUID, separate from the demo workspace.
NEXTCLOUD_WORKSPACE_ID=
NEXTCLOUD_MEMBER_GROUP=
# JSON array of exact source UIDs, used only on first product identity creation.
# Nextcloud admin membership does not grant product admin privileges.
NEXTCLOUD_BOOTSTRAP_ADMIN_IDS=[]
# Required by npm run workspace:init; no employees/content are imported.
WORKSPACE_NAME=


# Enable only after installing the compatible Talk app on the configured source.
NEXTCLOUD_TALK_ENABLED=false
# Files browsing and explicit personal text/Markdown imports. No automatic enterprise crawl.
NEXTCLOUD_FILES_ENABLED=false
